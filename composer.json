{
    "name": "cenef/touche-pas-au-klaxon",
    "description": "Application de covoiturage inter-sites - Touche pas au klaxon",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "izniburak/router": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "minimum-stability": "stable"
}
